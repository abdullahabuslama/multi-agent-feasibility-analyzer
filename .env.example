# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your keys stay on your machine.

# --- LLM ---------------------------------------------------------------
# Any provider supported by LangChain `init_chat_model` works.
# To switch provider: change these two lines and install its package
# (for example `langchain-openai` for "openai").
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key

# --- Embeddings (used by the RAG layer) --------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Qdrant vector store -----------------------------------------------
# Leave QDRANT_URL empty to use local mode (data saved in QDRANT_PATH).
# Set it (e.g. http://localhost:6333) to use a Qdrant server instead.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=.qdrant
QDRANT_COLLECTION=company_knowledge

# Folder with the company documents that get ingested into Qdrant
KNOWLEDGE_BASE_DIR=data/knowledge_base

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
